# Copy this file to .env and fill in values locally.
# Never commit .env. Never put real secrets in this file.

# Runtime environment: development | test | production
APP_ENV=development

# LLM provider: mock (default, no API key needed) | gemini | anthropic | openai
LLM_PROVIDER=mock

# API keys - leave empty unless you switch LLM_PROVIDER away from mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides for the real providers (ignored when LLM_PROVIDER=mock)
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
# GEMINI_MODEL=gemini-2.5-flash
# LLM_TIMEOUT_SECONDS=30

# Local SQLite database (ignored by git)
DATABASE_URL=sqlite:///./data/app.db

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional fixed "as of" date for the AR aging report (YYYY-MM-DD). Leave unset for today (UTC).
# AR_REPORT_AS_OF=2026-11-30

# Amount tolerances used when matching invoices to POs (rules defined in docs/specs/design.md)
# Absolute tolerance in US dollars
AMOUNT_TOLERANCE_USD=1.00
# Relative tolerance as a fraction (0.01 = 1%)
AMOUNT_TOLERANCE_PCT=0.01
